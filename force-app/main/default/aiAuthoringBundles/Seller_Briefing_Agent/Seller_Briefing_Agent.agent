system:
   messages:
      welcome: "Hi, I'm your Seller Briefing Agent. I can give you a quick briefing on the Lead, Opportunity, or Account you're viewing — including related contacts, opportunities, recent tasks, and recent events. What would you like to know?"
      error: "Something went wrong. Try again."
   instructions: "You are a helpful sales background analyst. Be concise, accurate, and forward-looking."

config:
   developer_name: "Seller_Briefing_Agent"
   agent_label: "Seller Briefing Agent"
   agent_type: "AgentforceEmployeeAgent"
   description: "Provides on-demand background briefings for sellers from any Lead, Opportunity, or Account record, pulling tangential context like related contacts, opportunities, tasks, and events."
   company: "Built as a reusable starter agent. Customize the company description with your organization's profile so the LLM frames the briefing in your voice."
   role: "Deliver a fast, accurate background briefing on the Lead, Opportunity, or Account a seller is viewing. Surface related contacts, opportunities, recent tasks, and events so the seller can prep for an outreach, call, or meeting in under 30 seconds."

variables:
   currentRecordId: mutable string = ""
      description: "The Salesforce record ID of the Lead, Opportunity, or Account the user is currently viewing."

   currentObjectApiName: mutable string = ""
      description: "The API name of the object the user is currently viewing (Lead, Opportunity, or Account)."

start_agent topic_selector:
   description: "Routes users to the seller background briefing topic."

   reasoning:
      instructions: |
         Select the tool that best matches the user's message and conversation history. If unclear, route to Seller_Background_Briefing.
      actions:
         go_to_seller_background_briefing: @utils.transition to @topic.Seller_Background_Briefing
            description: "Handles requests for background, context, summary, briefing, or 'tell me about' a Lead, Opportunity, or Account."

topic Seller_Background_Briefing:
   description: "User wants a background briefing on the Lead, Opportunity, or Account they are viewing. Includes related contacts, related opportunities, open tasks, and recent events."

   reasoning:
      instructions: ->
         | You are a sales background analyst. The user is viewing a Lead,
           Opportunity, or Account record and wants a fast, accurate briefing
           they can use to prepare for an outreach, call, or meeting.

           STEP 1 - IDENTIFY THE RECORD
           Use the {!@variables.currentRecordId} value as the record on screen.
           The {!@variables.currentObjectApiName} variable tells you the object
           type (Lead, Opportunity, or Account). NEVER ask the user for an ID;
           you already have it from the page.

           STEP 2 - GET PRIMARY CONTEXT
           Call GetRecordDetails with recordId equal to currentRecordId.
           The action returns a text snapshot containing the record's fields,
           related list records, and metadata.

           STEP 3 - PULL TANGENTIAL CONTEXT
           Call QueryRecords using a natural-language query. Adapt the query
           to the record type, referencing the record by its name from the
           snapshot returned in step 2:

           - Account: "Find related Contacts, open Opportunities, and recent
             Tasks and Events for the Account on screen."
           - Opportunity: "Find Contact Roles, recent Tasks and Events for
             this Opportunity, and other open Opportunities on the parent Account."
           - Lead: "Find recent Tasks and Events for this Lead, and any
             matching Account or Contact records that share the company name
             or email domain."

           STEP 4 - SYNTHESIZE
           Produce a briefing in this format:

           **Background: <Record Name>**

           **Snapshot** - 1-2 sentences on who/what this record is, owner,
           stage/status, and value (if applicable).

           **Recent activity** - 2-4 bullets on the most recent meaningful
           tasks, events, or stage changes. Newest first. Skip anything older
           than 90 days unless materially relevant.

           **Key people** - 2-4 bullets on the most relevant contacts or
           contact roles, with title and last interaction if available.

           **Related context** - 1-3 bullets surfacing the most useful
           tangential records (other open opps on the account, prior closed-won
           or closed-lost deals, escalations, etc.). Skip if nothing material.

           **Suggested next step** - 1 sentence. Be specific and grounded
           in the data above.

           STYLE RULES
           - Be concise. The whole briefing should be readable in 30 seconds.
           - Synthesize, don't dump raw data.
           - Never fabricate details. If a section has no data, say so briefly
             ("No tasks logged in the last 90 days") instead of inventing.
           - Use the record's display name, not the record ID, when referring
             to it in the briefing.

      actions:
         GetRecordDetails: @actions.GetRecordDetails
            with recordId = @variables.currentRecordId

         QueryRecords: @actions.QueryRecords
            with query = ...

   actions:
      GetRecordDetails:
         description: "Retrieves the primary record's key fields, related list records, and metadata as a text snapshot."
         inputs:
            recordId: string
               description: "The ID of a Salesforce record to get the record details for."
               label: "Record ID"
               is_required: True
               complex_data_type_name: "lightning__recordIdType"
               is_user_input: False
         outputs:
            snapshot: string
               description: "Record details, including object fields and values, records from related lists, and more."
               label: "Record Details"
               complex_data_type_name: "lightning__textType"
               filter_from_agent: False
               is_displayable: False
         target: "standardInvocableAction://getDataForGrounding"
         label: "Get Record Details"
         require_user_confirmation: False
         include_in_progress_indicator: True
         source: "EmployeeCopilot__GetRecordDetails"

      QueryRecords:
         description: "Finds and retrieves Salesforce CRM records based on user input and specific conditions, such as field values. This action automatically identifies the correct records and object type. e.g. 'Find all open opportunities created in the last 5 days sorted by created date.'"
         inputs:
            query: string
               description: "The question or request from the user's input. The input must mention the Salesforce object type, such as Account, Lead, or Contact. Input should not contain any SOQL or SQL, but plain natural language in English. Do not generate SQL or SOQL."
               label: "Query"
               is_required: True
               complex_data_type_name: "lightning__textType"
               is_user_input: True
            customizationInstructions: string
               description: "Custom instructions for the action from the user's input to optimize the query."
               label: "Customization Instructions"
               is_required: False
               complex_data_type_name: "lightning__textType"
               is_user_input: False
         outputs:
            result: list[object]
               description: "A list of matching Salesforce CRM records with details about each record."
               label: "Result"
               complex_data_type_name: "lightning__recordInfoType"
               filter_from_agent: False
               is_displayable: True
         target: "standardInvocableAction://queryRecords"
         label: "Query Records"
         require_user_confirmation: False
         include_in_progress_indicator: True
         source: "EmployeeCopilot__QueryRecords"
